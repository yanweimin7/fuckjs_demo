    "@fuickjs-community/haptics": "file:../../fuickjs_community/haptics",
    "@fuickjs-community/launcher": "file:../../fuickjs_community/launcher",
    "@fuickjs-community/media": "file:../../fuickjs_community/media",
    "@fuickjs-community/permissions": "file:../../fuickjs_community/permissions",
    "@fuickjs-community/share": "file:../../fuickjs_community/share",
    "@fuickjs-community/video_player": "file:../../fuickjs_community/video_player",
