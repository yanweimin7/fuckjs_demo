(Ã·¢04Y (œfunction isCheckmate(pieces, color) {
  const myPieces = pieces.filter((p) => p.color === color);
  for (const p of myPieces) {
    if (getValidMoves(p, pieces).length > 0) return false;
  }
  return true;
}C
à␀␀␀óÄ	␀␀ 1␀␀ˆ:␀0`␀␀º␀␀Ω␀␀&␀K§␀␀æ␀␀ø␀␀&␀K£␀␀¿␀␀.␀␀&␀K¢␀␀¡␀␀¡␀␀&␀K°␀␀¬␀␀¬␀␀&␀Kü␀␀√␀␀√␀␀&␀K•␀␀ƒ␀␀≈␀␀&␀K¶␀␀…a␀␀—F“ã␀␀≠Í¥ÏµF(ÃË¢␀â>’function getPieceName(type, color) {
  const names = {
    king: ["\u5E05", "\u5C06"],
    advisor: ["\u4ED5", "\u58EB"],
    elephant: ["\u76F8", "\u8C61"],
    horse: ["\u9A6C", "\u9A6C"],
    rook: ["\u8F66", "\u8F66"],
    cannon: ["\u70AE", "\u70AE"],
    pawn: ["\u5175", "\u5352"]
  };
  return names[type][color === "red" ? 0 : 1];
}C
