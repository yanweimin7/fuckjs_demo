␀␀Ü∂:␀␀å;␀␀§0␀␀∂:ˇˇˇˇ å; §0 ‘:␀0ú; û; :0é;0†È¢Í¶Ï§Î`␀`␀`␀␀—…“ ”ÚÍ∑€À`␀`␀`␀›ﬁ—“—Ãa␀È¥≠Í(¬8‰␀␀ã¬`␀a␀}Ï8¬`␀ﬂ‡—a␀”µùa␀8‰␀␀	“"␀¬a␀a␀ßÍa␀b␀a␀b␀Ä␀Í∆Éa␀(Ãõ§£45␀  .gU!+␀ºfunction getBestMove(pieces, aiColor, depth = 3) {
  const moves = sortMoves(getAllMoves(pieces, aiColor), pieces);
  if (moves.length === 0) return null;
  let bestMove = null;
  let bestScore = -Infinity;
  for (const move of moves) {
    const score = minimax(applyMove(pieces, move), depth - 1, bestScore, Infinity, false, aiColor);
    if (score > bestScore) {
      bestScore = score;
      bestMove = move;
    }
  }
  return bestMove;
