]!v∑ *61Ü&	DÖ *¶#function getRawMoves(piece, pieces) {
  const { type, color, row, col } = piece;
  const moves = [];
  switch (type) {
    case "king": {
      const dirs = [[0, 1], [0, -1], [1, 0], [-1, 0]];
      for (const [dr, dc] of dirs) {
        const nr = row + dr, nc = col + dc;
        if (inPalace(nr, nc, color)) {
          const target = getPieceAt(pieces, nr, nc);
          if (!target || target.color !== color) {
            moves.push({ row: nr, col: nc });
          }
        }
      }
      break;
    }
    case "advisor": {
      const dirs = [[1, 1], [1, -1], [-1, 1], [-1, -1]];
      for (const [dr, dc] of dirs) {
        const nr = row + dr, nc = col + dc;
        if (inPalace(nr, nc, color)) {
          const target = getPieceAt(pieces, nr, nc);
          if (!target || target.color !== color) {
            moves.push({ row: nr, col: nc });
          }
        }
      }
      break;
    }
    case "elephant": {
      const steps = [
        [2, 2, 1, 1],
        [2, -2, 1, -1],
        [-2, 2, -1, 1],
        [-2, -2, -1, -1]
      ];
      for (const [dr, dc, er, ec] of steps) {
        const nr = row + dr, nc = col + dc;
        if (!inBoard(nr, nc)) continue;
        if (color === "red" && !inRedHalf(nr)) continue;
        if (color === "black" && !inBlackHalf(nr)) continue;
        if (getPieceAt(pieces, row + er, col + ec)) continue;
        const target = getPieceAt(pieces, nr, nc);
        if (!target || target.color !== color) {
          moves.push({ row: nr, col: nc });
        }
      }
      break;
    }
    case "horse": {
      const steps = [
        [-2, -1, -1, 0],
        [-2, 1, -1, 0],
        [2, -1, 1, 0],
        [2, 1, 1, 0],
        [-1, -2, 0, -1],
        [-1, 2, 0, 1],
        [1, -2, 0, -1],
        [1, 2, 0, 1]
      ];
      for (const [dr, dc, er, ec] of steps) {
        const nr = row + dr, nc = col + dc;
        if (!inBoard(nr, nc)) continue;
        if (getPieceAt(pieces, row + er, col + ec)) continue;
        const target = getPieceAt(pieces, nr, nc);
        if (!target || target.color !== color) {
          moves.push({ row: nr, col: nc });
        }
      }
      break;
    }
    case "rook": {
      const dirs = [[0, 1], [0, -1], [1, 0], [-1, 0]];
      for (const [dr, dc] of dirs) {
        let nr = row + dr, nc = col + dc;
        while (inBoard(nr, nc)) {
          const target = getPieceAt(pieces, nr, nc);
          if (target) {
            if (target.color !== color) moves.push({ row: nr, col: nc });
            break;
          }
          moves.push({ row: nr, col: nc });
          nr += dr;
          nc += dc;
        }
      }
      break;
    }
    case "cannon": {
      const dirs = [[0, 1], [0, -1], [1, 0], [-1, 0]];
      for (const [dr, dc] of dirs) {
        let nr = row + dr, nc = col + dc;
        let jumpedOver = false;
        while (inBoard(nr, nc)) {
          const target = getPieceAt(pieces, nr, nc);
          if (!jumpedOver) {
            if (target) {
              jumpedOver = true;
            } else {
              moves.push({ row: nr, col: nc });
            }
          } else {
            if (target) {
              if (target.color !== color) moves.push({ row: nr, col: nc });
              break;
            }
          }
          nr += dr;
          nc += dc;
        }
      }
      break;
    }
    case "pawn": {
      if (color === "red") {
        const forward = { row: row - 1, col };
        if (inBoard(forward.row, forward.col)) {
          const t = getPieceAt(pieces, forward.row, forward.col);
          if (!t || t.color !== color) moves.push(forward);
        }
        if (!inRedHalf(row)) {
          for (const dc of [-1, 1]) {
            const nc = col + dc;
            if (inBoard(row, nc)) {
              const t = getPieceAt(pieces, row, nc);
              if (!t || t.color !== color) moves.push({ row, col: nc });
            }
          }
        }
      } else {
        const forward = { row: row + 1, col };
        if (inBoard(forward.row, forward.col)) {
          const t = getPieceAt(pieces, forward.row, forward.col);
          if (!t || t.color !== color) moves.push(forward);
        }
        if (!inBlackHalf(row)) {
          for (const dc of [-1, 1]) {
            const nc = col + dc;
            if (inBoard(row, nc)) {
              const t = getPieceAt(pieces, row, nc);
              if (!t || t.color !== color) moves.push({ row, col: nc });
            }
          }
        }
      }
      break;
    }
  }
  return moves;
}C
