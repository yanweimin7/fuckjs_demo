!	!	XN1]¦function F(ctx, x) {
          let a = x >> 24 & 255;
          let b = x >> 16 & 255;
          let c = x >> 8 & 255;
          let d = x & 255;
          let y = ctx.sbox[0][a] + ctx.sbox[1][b];
          y = y ^ ctx.sbox[2][c];
          y = y + ctx.sbox[3][d];
          return y;
        }C
„!␀␀´Œ!␀␀!␀␀’!␀␀”!␀ –! ˜! ô ü ¶␀`␀`␀`␀␀ØÏÙĞÑ`␀ºÒa␀d␀␀¥ğFa␀␀×@M␀␀a␀F¢b␀␀ä×a␀␀öa␀¢b␀a␀␀b␀a␀b␀␀a␀b␀a␀b␀ò³a␀␀b␀a␀b␀␀a␀b␀a␀×@M␀␀d␀␀F¢b␀a␀␀×@M␀␀d␀␀»œF¢b␀␀a␀␀KH␀␀a␀KI␀␀(äÂD	$␀,!#S0#+␀+␀c+␀+␀+␀S/çfunction BlowFish_Encrypt(ctx, left, right) {
          let Xl = left;
          let Xr = right;
          let temp;
          for (let i = 0; i < N; ++i) {
            Xl = Xl ^ ctx.pbox[i];
            Xr = F(ctx, Xl) ^ Xr;
            temp = Xl;
            Xl = Xr;
            Xr = temp;
          }
          temp = Xl;
          Xl = Xr;
          Xr = temp;
          Xr = Xr ^ ctx.pbox[N];
          Xl = Xl ^ ctx.pbox[N + 1];
          return { left: Xl, right: Xr };
        }C
†!␀␀°Œ!␀␀!␀␀’!␀␀”!␀ –! ˜! ô ü ¶␀`␀`␀`␀␀ØÏÙĞÑ`␀d␀␀»œÒa␀»§ğFa␀␀×@M␀␀a␀F¢b␀␀ä×a␀␀öa␀¢b␀a␀␀b␀a␀b␀␀a␀b␀a␀b␀òµa␀␀b␀a␀b␀␀a␀b␀a␀×@M␀␀»F¢b␀a␀␀×@M␀␀ºF¢b␀␀a␀␀KH␀␀a␀KI␀␀(äÔD	$␀& +S0#+␀+␀c+␀+␀+␀Içfunction BlowFish_Decrypt(ctx, left, right) {
          let Xl = left;
          let Xr = right;
          let temp;
          for (let i = N + 1; i > 1; --i) {
            Xl = Xl ^ ctx.pbox[i];
            Xr = F(ctx, Xl) ^ Xr;
            temp = Xl;
            Xl = Xr;
            Xr = temp;
          }
          temp = Xl;
          Xl = Xr;
          Xr = temp;
          Xr = Xr ^ ctx.pbox[1];
          Xl = Xl ^ ctx.pbox[0];
          return { left: Xl, right: Xr };
        }C
