            const tokens = s.trim().split(/\s+/);
            let color = "#000";
            const nums = [];
            for (const t of tokens) {
              const n = parseFloat(t);
              if (!isNaN(n))
                nums.push(n);
              else if (t !== "inset")
                color = t;
            }
            const dx = nums[0] ?? 0, dy = nums[1] ?? 0;
            const blur = nums[2] ?? 0, spread = nums[3] ?? 0;
            return { offset: { dx, dy }, blurRadius: blur, spreadRadius: spread, color };
