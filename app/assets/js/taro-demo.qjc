¿commit() {
        try {
          if (!this.diffStrategy.rendered) {
            this.diffStrategy.commit();
          } else if (this.incrementalMode) {
            this.incrementalStrategy.commit();
          } else {
            this.diffStrategy.commit();
          }
        } catch (e) {
          console.error(`[PageContainer] Error during commit for page ${this.pageId}:`, e);
        } finally {
          this.clear();
        }
