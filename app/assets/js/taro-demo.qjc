        if (this.incrementalMode) {
          this.recordRemoval(parent, child);
        } else {
          this.markChanged(parent);
        }
      }B␀␀␀␀!ﬁ.␀␀␀␀…≈—BT␀␀≈A˝␀␀—$␀≈@ï␀␀	Bp␀␀)Ã√á&␀ "!èappendChildToContainer(child) {
