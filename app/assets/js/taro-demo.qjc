␀␀=@␀DÇ??	áfunction connectSocket(option) {
      const { url, protocols, success, fail, complete } = option;
      try {
        const ws = new WebSocket(url, protocols);
        _socket = ws;
        const openCallbacks = [];
        const messageCallbacks = [];
        const errorCallbacks = [];
        const closeCallbacks = [];
        ws.onopen = (event) => {
          for (const cb of openCallbacks) {
            try {
              cb(event);
            } catch {
            }
          }
        };
        ws.onmessage = (event) => {
          for (const cb of messageCallbacks) {
            try {
              cb({ data: event.data });
            } catch {
            }
          }
        };
        ws.onerror = (event) => {
          for (const cb of errorCallbacks) {
            try {
              cb(event);
            } catch {
            }
          }
        };
        ws.onclose = (event) => {
          for (const cb of closeCallbacks) {
            try {
              cb({ code: event.code, reason: event.reason });
            } catch {
            }
          }
        };
        const task = {
          send(opt) {
            ws.send(opt.data);
            opt.success?.();
            opt.complete?.();
          },
          close(opt = {}) {
            ws.close(opt.code ?? 1e3, opt.reason ?? "");
            opt.success?.();
            opt.complete?.();
          },
          onOpen(callback) {
            openCallbacks.push(callback);
          },
          onMessage(callback) {
            messageCallbacks.push(callback);
          },
          onError(callback) {
            errorCallbacks.push(callback);
          },
          onClose(callback) {
            closeCallbacks.push(callback);
          }
        };
        success?.(task);
        complete?.(task);
        return task;
      } catch (e) {
        fail?.(e);
        complete?.(e);
        throw e;
      }
    }C
